# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduhub
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=7d

# ── Email (SMTP Configuration) ───────────────────────────────────────────────
# IMPORTANT: Use SMTP_* variables (not MAIL_*)
# For Gmail: You MUST use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
#
# FOR PRODUCTION: These values come from GitHub Secrets (see GITHUB_SECRETS.md)
# FOR LOCAL DEV: Add your credentials here (NEVER commit them!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rivntam@gmail.com
SMTP_PASS=nqmy lnvp jyow kufk
EMAIL_FROM=admissions@eduhub.ac.za
ADMISSIONS_EMAIL=admissions@eduhub.ac.za
